# AI Career OS - Environment Variables

# ─── FRONTEND (ascend/) ───────────────────────────────────────
# Set this on Vercel: Settings → Environment Variables → VITE_API_URL
# Leave blank to use Vercel's built-in /api serverless routing (recommended)
# VITE_API_URL=https://your-backend.onrender.com/api

# ─── BACKEND (backend/) ──────────────────────────────────────
# Set these on Vercel: Settings → Environment Variables
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-career-os?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-strong-random-secret-min-32-chars
PORT=5000
NODE_ENV=production
